# Server
APP_ENV=development
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
# Comma-separated. Production must list explicit app/web origins; wildcard is rejected.
CORS_ALLOWED_ORIGINS=*

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=phonara
DB_USER=phonara
DB_PASSWORD=phonara_secret
DB_POOL_MAX_CONNS=25
DB_POOL_MIN_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# S3 / Object Storage (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_AUDIO=phonara-audio
# HAI bucket tách riêng — đây là ranh giới bảo mật, không phải quy ước đặt tên.
# Audio mẫu công khai được; bản ghi giọng người dùng thì KHÔNG.
# Tách bucket để phân quyền hạ tầng cưỡng chế, thay vì dựa vào code nhớ kiểm tiền tố.
S3_BUCKET_SAMPLES=phonara-samples
S3_BUCKET_RECORDINGS=phonara-recordings
# s3 (mặc định, production) | local (chỉ hợp một instance — api và worker phải chung đĩa)
STORAGE_DRIVER=s3
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_TOKEN_TTL=60s

# Azure TTS
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus
# Giọng đọc mẫu. Chưa có AZURE_TTS_KEY thì worker để sample_audio_url RỖNG
# thay vì bịa URL — URL chết tệ hơn URL trống (client mất ~3,6s mới biết là hỏng).
# KHÔNG dùng espeak-ng làm nguồn: /θ/ của nó nghe như /f/, dạy sai người học.
AZURE_TTS_VOICE=en-US-AriaNeural

# Speechace
SPEECHACE_API_KEY=

# Apple IAP
APPLE_IAP_SHARED_SECRET=

# Google IAP
GOOGLE_IAP_PACKAGE_NAME=

# FCM
FCM_SERVER_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=

# Freemium
FREEMIUM_DAILY_LIMIT=10

# Asynq / Worker
ASYNQ_CONCURRENCY=10

# Rate Limiting (token broker)
RATE_LIMIT_TOKEN_PER_USER_PER_MIN=6
RATE_LIMIT_TOKEN_PER_IP_PER_MIN=20

# Cost circuit breaker (USD/hour)
COST_CIRCUIT_BREAKER_THRESHOLD=50.0

# Pronunciation Engine (service Python nội bộ — KHÔNG expose ra Internet)
PRONUNCIATION_ENGINE_URL=http://pronunciation-engine:8000
PRONUNCIATION_ENGINE_TIMEOUT=2m
# PHẢI khớp PE_MAX_CONCURRENT_INFERENCE của engine. Cao hơn nghĩa là worker bắn nhiều job
# hơn engine nhận; engine trả 503 và Asynq cho job ngủ 15-44 giây trước lần retry đầu.
PRONUNCIATION_ENGINE_CONCURRENCY=1
# Hạn chờ suất inference trong worker. Quá hạn thì nhường chỗ cho task loại khác (Asynq
# dùng chung pool goroutine cho mọi task) và quay lại sau vài giây.
PRONUNCIATION_ENGINE_ACQUIRE_TIMEOUT=45s

# Nơi lưu audio người dùng ghi. LocalStore chỉ hợp cho 1 instance;
# nhiều instance phải chuyển sang S3/MinIO (xem internal/integration/storage).
AUDIO_STORAGE_ROOT=/var/lib/phonara/audio
