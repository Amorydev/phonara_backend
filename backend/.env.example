# Server
APP_ENV=development
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=phonara
DB_USER=phonara
DB_PASSWORD=phonara_secret
DB_POOL_MAX_CONNS=25
DB_POOL_MIN_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# S3 / Object Storage (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_AUDIO=phonara-audio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_TOKEN_TTL=60s

# Azure TTS
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus

# Speechace
SPEECHACE_API_KEY=

# Apple IAP
APPLE_IAP_SHARED_SECRET=

# Google IAP
GOOGLE_IAP_PACKAGE_NAME=

# FCM
FCM_SERVER_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=

# Freemium
FREEMIUM_DAILY_LIMIT=10

# Asynq / Worker
ASYNQ_CONCURRENCY=10

# Rate Limiting (token broker)
RATE_LIMIT_TOKEN_PER_USER_PER_MIN=6
RATE_LIMIT_TOKEN_PER_IP_PER_MIN=20

# Cost circuit breaker (USD/hour)
COST_CIRCUIT_BREAKER_THRESHOLD=50.0
