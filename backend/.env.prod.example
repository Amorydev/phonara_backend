# Mẫu .env cho production. Chép thành `.env` TRÊN VPS rồi điền.
#
#   cp .env.prod.example .env && chmod 600 .env
#
# TUYỆT ĐỐI KHÔNG commit file .env đã điền, và không dùng lại bất kỳ giá trị nào của máy dev.
# Mật khẩu trong docker-compose.yml (bản dev) là công khai trong git — coi như đã lộ.
#
# Sinh toàn bộ khoá bí mật bằng một lệnh:
#
#   for k in JWT_SECRET DB_PASSWORD REDIS_PASSWORD S3_SECRET_KEY; do \
#     echo "$k=$(openssl rand -base64 32 | tr -d '/+=' | head -c 40)"; done

# ── Tên miền và HTTPS ─────────────────────────────────────────────────────────
# DOMAIN phải đã trỏ A record về IP của VPS TRƯỚC khi khởi động, nếu không Let's Encrypt
# không xác minh được và Caddy sẽ thử lại liên tục.
DOMAIN=api.phonara.online
# Email nhận cảnh báo chứng chỉ sắp hết hạn. Dùng email thật.
TLS_EMAIL=admin@phonara.online

# ── Bí mật ────────────────────────────────────────────────────────────────────
# Đổi JWT_SECRET là VÔ HIỆU HOÁ mọi phiên đang đăng nhập. Chấp nhận được lúc mới deploy,
# nhưng sau này đổi thì mọi người dùng bị đăng xuất.
JWT_SECRET=
DB_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=phonara
S3_SECRET_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=phonara
DB_USER=phonara
DB_POOL_MAX_CONNS=25
DB_POOL_MIN_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_DB=0

# ── Kho audio ─────────────────────────────────────────────────────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_BUCKET_SAMPLES=phonara-samples
S3_BUCKET_RECORDINGS=phonara-recordings

# ── Engine chấm phát âm ───────────────────────────────────────────────────────
PRONUNCIATION_ENGINE_URL=http://pronunciation-engine:8000

# ── Azure TTS ─────────────────────────────────────────────────────────────────
# Chỉ dùng để SINH audio mẫu, không gọi theo lượt người dùng. Để trống thì worker bỏ qua
# và `sample_audio_url` để rỗng — app vẫn chạy, chỉ không có audio mẫu.
AZURE_TTS_KEY=
AZURE_TTS_REGION=southeastasia
AZURE_TTS_VOICE=en-US-AriaNeural

# ── Chưa dùng ─────────────────────────────────────────────────────────────────
# Chấm phát âm đã tự host, hai khoá dưới đây để trống. Xem §9 của plan.
AZURE_SPEECH_KEY=
SPEECHACE_API_KEY=
