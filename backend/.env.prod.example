# Mẫu .env cho production. Chép thành `.env` TRÊN VPS rồi điền.
#
#   cp .env.prod.example .env && chmod 600 .env
#
# File này là bản ĐẦY ĐỦ, giữ song song với `.env.example`. Bản trước đó chỉ liệt kê những
# biến tôi nhớ ra và thiếu 24 biến — trong đó có JWT_ACCESS_SECRET, khiến api crash-loop
# ngay khi khởi động. Sửa cho đúng: chép trọn `.env.example` rồi đổi các giá trị dành cho
# production, thay vì viết lại từ đầu.
#
# Kiểm file có đủ biến hay không:
#   make env-check
#
# ── COMPOSE_FILE ──────────────────────────────────────────────────────────────
#
# Compose đọc biến này từ `.env`, nên khi đã đặt thì `docker compose up -d`,
# `docker compose ps`, `docker compose logs` đều tự dùng đúng file — không ai phải gõ `-f`,
# và không ai gõ nhầm.
#
# Đây không phải tiện nghi mà là CHỐT AN TOÀN. Các file production đều TỰ CHỨA. Ghép thêm
# `-f docker-compose.yml` (bản dev) thì compose GỘP `ports` chứ không thay thế, kéo theo
# nguyên bộ cổng dev: postgres 5432, redis 6379, minio 9000/9001 phơi thẳng ra internet,
# api publish cả 0.0.0.0:8080 nên đi vòng qua nginx lẫn TLS. Tệ hơn, compose thấy spec lệch
# với container đang chạy nên TẠO LẠI chúng — và nếu máy đã có tiến trình khác giữ 5432 thì
# postgres không khởi động lại được, để lại stack thiếu database.
#
# Đã xảy ra thật trên VPS: API trả 500 với `lookup postgres: server misbehaving` vì container
# postgres không còn tồn tại.
#
# Đặt đúng MỘT giá trị, theo cách máy này chạy:
#   - máy đã có nginx/Apache giữ 80/443 → docker-compose.behind-proxy.yml
#   - máy trống, để Caddy tự lo TLS      → docker-compose.prod.yml
COMPOSE_FILE=docker-compose.behind-proxy.yml
#
# TUYỆT ĐỐI KHÔNG commit file .env đã điền, và không dùng lại giá trị nào của máy dev —
# mật khẩu trong docker-compose.yml nằm công khai trong git, coi như đã lộ.
#
# Sinh toàn bộ khoá bí mật bằng một lệnh:
#
#   for k in JWT_ACCESS_SECRET JWT_REFRESH_SECRET DB_PASSWORD REDIS_PASSWORD S3_SECRET_KEY; do \
#     echo "$k=$(openssl rand -base64 32 | tr -d '/+=' | head -c 40)"; done

# ── Tên miền và HTTPS ─────────────────────────────────────────────────────────
# DOMAIN phải đã trỏ A record về IP của VPS TRƯỚC khi khởi động, nếu không Let's Encrypt
# không xác minh được. Chỉ dùng bởi docker-compose.prod.yml (bản có Caddy); bản
# behind-proxy thì tên miền khai trong vhost nginx.
DOMAIN=api.phonara.online
TLS_EMAIL=admin@phonara.online

# ── Server ────────────────────────────────────────────────────────────────────
APP_ENV=production
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
# Production PHẢI liệt kê origin cụ thể; dấu sao bị từ chối. App di động không gửi Origin
# nên để trống cũng được — chỉ cần thiết khi có web client.
CORS_ALLOWED_ORIGINS=https://phonara.online

# Cổng nội bộ api gắn vào (chỉ 127.0.0.1), dùng bởi docker-compose.behind-proxy.yml.
# Đổi thì PHẢI đổi `proxy_pass` trong deploy/nginx-api.phonara.online.conf cho khớp.
API_BIND_PORT=8090

# URL công khai, dùng để dựng link tuyệt đối trong phản hồi.
PUBLIC_BASE_URL=https://api.phonara.online

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=phonara
DB_USER=phonara
DB_PASSWORD=
DB_POOL_MAX_CONNS=25
DB_POOL_MIN_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────────────────────
# HAI khoá khác nhau, không dùng chung một giá trị: khoá access rò rỉ thì refresh token
# vẫn an toàn, và ngược lại.
#
# Đổi khoá là VÔ HIỆU HOÁ mọi phiên đang đăng nhập.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── Kho audio ─────────────────────────────────────────────────────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=phonara
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_BUCKET_AUDIO=phonara-audio
# HAI bucket tách riêng — ranh giới bảo mật, không phải quy ước đặt tên. Audio mẫu công
# khai được; bản ghi giọng người dùng thì KHÔNG.
S3_BUCKET_SAMPLES=phonara-samples
S3_BUCKET_RECORDINGS=phonara-recordings
AUDIO_STORAGE_ROOT=/var/lib/phonara/audio

# ── Engine chấm phát âm ───────────────────────────────────────────────────────
PRONUNCIATION_ENGINE_URL=http://pronunciation-engine:8000
PRONUNCIATION_ENGINE_TIMEOUT=30s
# Hàng đợi sâu quá mức này thì API từ chối sớm thay vì để người dùng chờ vô định.
MAX_ASSESSMENT_QUEUE_DEPTH=100

# ── Azure TTS ─────────────────────────────────────────────────────────────────
# Chỉ dùng để SINH audio mẫu, không gọi theo lượt người dùng. Để trống thì worker bỏ qua
# và `sample_audio_url` để rỗng — app vẫn chạy, chỉ không có audio mẫu.
AZURE_TTS_KEY=
AZURE_TTS_REGION=southeastasia
AZURE_TTS_VOICE=en-US-AriaNeural

# ── Freemium và giới hạn tần suất ─────────────────────────────────────────────
FREEMIUM_DAILY_LIMIT=10
RATE_LIMIT_TOKEN_PER_USER_PER_MIN=6
RATE_LIMIT_TOKEN_PER_IP_PER_MIN=20
COST_CIRCUIT_BREAKER_THRESHOLD=50.0

# ── Worker ────────────────────────────────────────────────────────────────────
ASYNQ_CONCURRENCY=10

# ── Chưa dùng ─────────────────────────────────────────────────────────────────
# Chấm phát âm đã tự host nên hai khoá Azure/Speechace để trống (xem §9 của plan).
# Bốn khoá còn lại là của các tính năng đang trả 503 — điền khi xây xong.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_TOKEN_TTL=60s
SPEECHACE_API_KEY=
APPLE_IAP_SHARED_SECRET=
GOOGLE_IAP_PACKAGE_NAME=
GOOGLE_CLIENT_ID=
FCM_SERVER_KEY=
